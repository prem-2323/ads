# MasterTools Environment Variables Example
# Copy this file to .env or .env.local for local testing.
# On Vercel, set these in Project Settings -> Environment Variables.

# Google Analytics 4 Measurement ID (Optional)
# Format: G-XXXXXXXXXX
# If left empty or missing, Google Analytics script will NOT be loaded.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google AdSense Publisher & Slot Configuration (Optional)
# Format: ca-pub-XXXXXXXXXXXXXXXX
# If left empty or unconfigured, AdSlot components will run in clean placeholder mode.
VITE_ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_AD_SLOT_HOME=XXXXXXXXXX
VITE_AD_SLOT_TOOL=XXXXXXXXXX
VITE_AD_SLOT_ARTICLE=XXXXXXXXXX
VITE_AD_SLOT_SIDEBAR=XXXXXXXXXX
